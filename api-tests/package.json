{
  "name": "api-tests",
  "version": "1.3.0",
  "description": "Testes de API com Supertest + Mocha + Chai + Zod + TypeScript — Desafio Banco Carrefour",
  "private": true,
  "scripts": {
    "pretest":         "tsc --noEmit",
    "test":            "mocha --require ts-node/register --require tsconfig-paths/register --require src/config/setup.ts --require src/config/hooks.ts 'src/tests/**/*.test.ts' --reporter mocha-multi-reporters --reporter-options configFile=reporter-config.json",
    "test:watch":      "mocha --require ts-node/register --require tsconfig-paths/register --require src/config/setup.ts --require src/config/hooks.ts 'src/tests/**/*.test.ts' --watch",
    "report:html":     "node_modules/.bin/open-cli reports/api-report.html",
    "report:allure":   "yarn allure:generate && yarn allure:open",
    "allure:generate": "allure generate allure-results -o allure-report --clean",
    "allure:open":     "allure open allure-report",
    "clean":           "rimraf reports allure-results allure-report dist",
    "typecheck":       "tsc --noEmit",
    "lint":            "eslint src --ext .ts"
  },
  "devDependencies": {
    "zod":                              "^3.23.8",
    "allure-commandline":               "^2.30.0",
    "allure-js-commons":                "^3.3.0",
    "allure-mocha":                     "^3.3.0",
    "chai":                             "^4.4.1",
    "dotenv":                           "^16.4.5",
    "mocha":                            "^10.3.0",
    "mocha-multi-reporters":            "^1.5.1",
    "mochawesome":                      "^7.1.3",
    "open-cli":                         "^8.0.0",
    "rimraf":                           "^5.0.5",
    "supertest":                        "^6.3.4",
    "ts-node":                          "^10.9.2",
    "tsconfig-paths":                   "^4.2.0",
    "typescript":                       "^5.3.3",
    "@types/chai":                      "^4.3.12",
    "@types/mocha":                     "^10.0.6",
    "@types/node":                      "^20.11.30",
    "@types/supertest":                 "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser":        "^7.3.1",
    "eslint":                           "^8.57.0"
  }
}
